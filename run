#!/usr/bin/env bash
#
# usage: ./run command [argument ...]
#
# Commands for dog-colors development.
#

set -o nounset
set -o pipefail
set -o errexit

# Change the current directory to the project root.
PROJECT_ROOT=${0%/*}
if [[ $0 != $PROJECT_ROOT && $PROJECT_ROOT != "" ]]; then
  cd "$PROJECT_ROOT"
fi
readonly PROJECT_ROOT=$(pwd)

################################################################################
# Development Commands

function setup {
  #@ Install dependencies from the lockfile
  #@ Category: Development
  npm ci
}

function dev {
  #@ Start the Vite dev server (extra arguments go to vite)
  #@ Category: Development
  npx --no-install vite "$@"
}

function preview {
  #@ Serve the production build from dist/ (extra arguments go to vite)
  #@ Category: Development
  npx --no-install vite preview "$@"
}

function preview-fixtures {
  #@ Build with the dev-only fixture states into dist-fixtures/ and serve it with the CSP (extra arguments go to vite preview)
  #@ Category: Development
  npx --no-install vite build --mode fixtures --outDir dist-fixtures
  npx --no-install vite preview --outDir dist-fixtures "$@"
}

function fixtures {
  #@ [samples-dir]: rewrite tests/fixtures/sample-*.json from the local sample reports
  #@ Category: Development
  node scripts/extract-fixtures.ts "${1:-_local/samples}"
}

function conditions {
  #@ [samples-dir]: rewrite src/health/conditions.json from the local current-format sample reports
  #@ Category: Development
  node scripts/build-conditions.ts "${1:-_local/samples}"
}

function record-readings {
  #@ Record the local sample reports' full readings and the pdfjs-dist version for the current reader version
  #@ Category: Development
  if [[ ! -f _local/samples/manifest.json ]]; then
    echo "record-readings: _local/samples/manifest.json is missing" >&2
    return 1
  fi
  RECORD_READINGS=1 npx --no-install vitest run tests/report/real-pdfs.local.test.ts
}

################################################################################
# Quality Commands

function typecheck {
  #@ Type-check all TypeScript sources
  #@ Category: Quality
  npx --no-install tsc --noEmit
}

function test {
  #@ Run the unit tests (extra arguments go to vitest)
  #@ Category: Quality
  npx --no-install vitest run "$@"
}

function check-csp {
  #@ Check that dist/index.html carries the Content-Security-Policy meta tag
  #@ Category: Quality
  node scripts/csp-check.ts dist/index.html
}

function check-fixtures {
  #@ Check that dist/ carries none of the dev-only fixture states (run after build)
  #@ Category: Quality
  node scripts/fixture-check.ts dist
}

function check-pdfs {
  #@ [base-ref]: fail if a PDF is tracked by name or content; given base-ref, also if base-ref..HEAD added one
  #@ Category: Quality
  scripts/check-pdfs.sh "$@"
}

################################################################################
# Build Commands

function build {
  #@ Build the production site into dist/
  #@ Category: Build
  npx --no-install vite build
}

################################################################################
# Help System

function help {
  #@ Show this help message
  #@ Category: Core
  echo "Puppy colour predictor - Development Commands"
  echo "============================================="
  echo ""
  echo "Available commands:"
  echo ""

  # Extract function definitions and their help comments
  awk '/^function / {
    fname = $2
    sub(/[({].*/, "", fname)
    getline
    if ($0 ~ /#@/) {
      desc = $0
      sub(/.*#@ /, "", desc)
      sub(/ *$/, "", desc)
      getline
      if ($0 ~ /#@ Category:/) {
        cat = $0
        sub(/.*Category: /, "", cat)
        sub(/ *$/, "", cat)
        if (!seen[cat]++) categories[++cat_count] = cat
        commands[cat, ++cmd_count[cat]] = fname
        descriptions[cat, cmd_count[cat]] = desc
      }
    }
  }
  END {
    for (i = 1; i <= cat_count; i++) {
      cat = categories[i]
      print "\n" cat ":"
      for (j = 1; j <= cmd_count[cat]; j++) {
        printf "  %-25s %s\n", commands[cat, j], descriptions[cat, j]
      }
    }
  }' "$0"

  echo ""
  echo "Usage: ./run <command> [arguments...]"
  echo ""
}

################################################################################
# Commands end.

TIMEFORMAT=$'\nTask completed in %3lR'
time "${@:-help}"
